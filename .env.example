# Sao chép thành .env rồi điền giá trị của project bạn.
# Lấy ở Supabase Dashboard → Project Settings → API Keys.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ── Khoá app dùng ────────────────────────────────────────────────────────
# PHẢI là publishable key (sb_publishable_...) hoặc anon key kiểu cũ.
#
# Khoá này công khai được: thứ bảo vệ dữ liệu là Row Level Security, không
# phải khoá. Mỗi người dùng chỉ thấy hàng có user_id = auth.uid() của họ.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# ── KHÔNG đặt secret key vào biến trên ───────────────────────────────────
# Hai lý do, cả hai đều đã kiểm chứng trên project thật:
#
#   1. App desktop phát tán .env cùng file exe. Secret key ở đó = trao toàn
#      quyền database cho bất kỳ ai cầm bản build.
#   2. App sẽ hỏng ngay. service_role bypass RLS nên auth.uid() trả NULL, và
#      INSERT vào snapshots fail với 23502 (user_id NOT NULL).
#
# Code đã chặn: Config::from_env() từ chối khởi động nếu phát hiện
# sb_secret_... hoặc JWT có role service_role.
#
# Nếu cần secret key cho việc quản trị (tạo user đã xác nhận sẵn, dọn dữ
# liệu), đặt ở biến RIÊNG bên dưới. App không bao giờ đọc biến này — chỉ
# script quản trị và test dùng tới.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Chỉ dành cho test end-to-end ─────────────────────────────────────────
# CS_TEST_EMAIL=...
# CS_TEST_PASSWORD=...
